{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onboard External API Gateway auth-oauth orders-quotes API",
    "version": "3.0.2"
  },
  "items": [
    {
      "info": {
        "name": "orders-quotes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request a Quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://external.dev.onboardpay.co/orders/quotes",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-auth-token",
              "value": "{{x-auth-token}}",
              "placement": "header"
            }
          },
          "docs": "Request a Quote"
        },
        {
          "info": {
            "name": "get base rates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://external.dev.onboardpay.co/orders/quotes/rates",
            "params": [
              {
                "name": "payoutCurrency",
                "value": "",
                "type": "query",
                "description": "Payment account Currency"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-auth-token",
              "value": "{{x-auth-token}}",
              "placement": "header"
            }
          },
          "docs": "get base rates"
        },
        {
          "info": {
            "name": "get reference rates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://external.dev.onboardpay.co/orders/quotes/reference-rate",
            "params": [
              {
                "name": "payoutCurrency",
                "value": "",
                "type": "query",
                "description": "Payment account Currency"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type or transaction (BUY/SELL)"
              }
            ]
          },
          "docs": "get reference rates"
        }
      ]
    }
  ],
  "bundled": true
}